generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model tokens {
  jti        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  useruuid   String   @db.Uuid
  expires_at DateTime
  users      users    @relation(fields: [useruuid], references: [uuid], onDelete: Cascade, map: "rel_users_uuid")
}

model users {
  uuid            String    @id @unique(map: "uuid_unique") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime
  hashed_email    String    @unique(map: "hashed_email_unique") @db.Char(64)
  auth_method     auth_type
  encrypted_email String    @db.VarChar(259)
  username        String    @db.VarChar(30)
  srp_salt        String?   @db.Char(64)
  srp_verifier    String?   @db.Char(512)
  verified        Boolean   @default(false)
  handle          String    @unique(map: "handle_unique") @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  avatar_version  String?   @db.Uuid
  banner_version  String?   @db.Uuid
  biography       String    @default("I like it here") @db.VarChar(1000)
  admin           Boolean   @default(false)
  tokens          tokens[]
}

model audio_logs {
  uuid     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  language languages
  text     String    @db.VarChar(500)

  @@map("audio logs")
}

enum auth_type {
  Google
  OpacubeVIP
  Discord
  Github
  Twitch
  Gitlab
}

enum token_type {
  access
  refresh
  login
  verify
  oauthlogin
}

